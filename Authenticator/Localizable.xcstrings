        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Server nedokázal preukázať, že pozná vaše heslo. Skontrolujte adresu servera."
          }
        }
      }
    },
    "The sign in session has expired. Start over." : {
      "comment" : "Ente sign in error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Anmeldesitzung ist abgelaufen. Beginne von vorn."
