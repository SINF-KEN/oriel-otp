    },
    "The Ente account your codes are in now. Your password never leaves this device." : {
      "comment" : "Ente migration old server sign in footer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Ente-Konto, in dem sich deine Codes jetzt befinden. Dein Passwort verlässt dieses Gerät nie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
