    "Accounts restored: %lld" : {
      "comment" : "Backup restore result. The placeholder is a number.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederhergestellte Konten: %lld"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comptes restaurés : %lld"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復元したアカウント：%lld"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnovené účty: %lld"
          }
        }
      }
    },
    "Accounts saved on this device can be backed up to a file encrypted with a password you choose. There are none yet. A backup, or an encrypted export from Ente Auth, can be restored here." : {
      "comment" : "Backup settings footer without accounts on this device",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät gespeicherte Konten können in einer Datei gesichert werden, die mit einem Passwort deiner Wahl verschlüsselt ist. Noch gibt es keine. Ein Backup oder ein verschlüsselter Export aus Ente Auth kann hier wiederhergestellt werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les comptes enregistrés sur cet appareil peuvent être sauvegardés dans un fichier chiffré avec un mot de passe de votre choix. Il n’y en a pas encore. Une sauvegarde, ou un export chiffré d’Ente Auth, peut être restaurée ici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスに保存したアカウントは、自分で決めたパスワードで暗号化したファイルにバックアップできます。まだアカウントはありません。バックアップやEnte Authの暗号化エクスポートは、ここで復元できます。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účty uložené v tomto zariadení možno zálohovať do súboru zašifrovaného heslom, ktoré si zvolíte. Zatiaľ tu žiadne nie sú. Zálohu alebo šifrovaný export z Ente Auth možno obnoviť tu."
          }
        }
      }
    },
    "Add %@" : {
      "comment" : "AutoFill websites button. The placeholder is a website made up from the account's name, e.g. mastodon.com.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ hinzufügen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajouter %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@を追加"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pridať %@"
          }
        }
      }
    },
    "Add it only if it's where you sign in to this account. Codes aren't suggested on a website until you add it." : {
      "comment" : "AutoFill websites footer below a website made up from the account's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Füge sie nur hinzu, wenn du dich dort bei diesem Konto anmeldest. Codes werden auf einer Website erst vorgeschlagen, wenn du sie hinzufügst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajoutez-le seulement si c’est là que vous vous connectez à ce compte. Les codes ne sont suggérés sur un site qu’une fois que vous l’avez ajouté."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このアカウントにサインインするWebサイトである場合にのみ追加してください。追加するまで、そのWebサイトでコードは提案されません。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pridajte ju, len ak sa na nej prihlasujete do tohto účtu. Kódy sa na webovej stránke navrhujú až po jej pridaní."
          }
        }
      }
    },
    "Already on this device: %lld" : {
      "comment" : "Backup restore result. The placeholder is a number of accounts.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereits auf diesem Gerät: %lld"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjà sur cet appareil : %lld"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでにこのデバイスにあるもの：%lld"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Už v tomto zariadení: %lld"
          }
        }
      }
    },
    "Another app already uses %@. Quit it or change its shortcut, then turn Quick Copy off and on." : {
      "comment" : "Mac setting footer. The placeholder is a keyboard shortcut, e.g. ⌥⌘O.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine andere App verwendet bereits %@. Beende sie oder ändere ihr Tastenkürzel und schalte die Schnellkopie dann aus und wieder ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une autre app utilise déjà %@. Quittez-la ou changez son raccourci, puis désactivez et réactivez la copie rapide."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "別のアプリがすでに%@を使用しています。そのアプリを終了するかショートカットを変更してから、クイックコピーをオフにしてもう一度オンにしてください。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Iná aplikácia už používa %@. Ukončite ju alebo zmeňte jej skratku a potom rýchle kopírovanie vypnite a znova zapnite."
          }
        }
      }
    },
    "Ask for %@ to Copy" : {
      "comment" : "Menu. The placeholder is Face ID, Touch ID, Optic ID, Device passcode or Mac password.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zum Kopieren nach %@ fragen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Demander %@ pour copier"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "コピー時に%@を要求"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Na kopírovanie vyžadovať %@"
          }
        }
      }
    },
    "Ask for this before showing or copying the code for %@." : {
      "comment" : "Face ID or Touch ID prompt when protecting an account. The placeholder is the account's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vor dem Anzeigen oder Kopieren des Codes für %@ danach fragen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Demander ceci avant d’afficher ou de copier le code de %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@のコードを表示またはコピーする前に確認します。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pýtať sa na toto pred zobrazením alebo skopírovaním kódu pre %@."
          }
        }
      }
    },
