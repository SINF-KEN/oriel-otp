          }
        }
      }
    },
    "To prevent unauthorized access this YubiKey is protected with a password." : {
      "comment" : "OATH password entry enter password",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um unbefugten Zugriff zu verhindern, ist dieser YubiKey mit einem Passwort geschützt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
