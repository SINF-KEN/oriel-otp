        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Účet Ente, v ktorom sú teraz vaše kódy. Vaše heslo toto zariadenie nikdy neopustí."
          }
        }
      }
    },
    "The FIDO application of your YubiKey has been reset to factory defaults." : {
      "comment" : "FIDO reset view",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die FIDO-Anwendung deines YubiKey wurde auf die Werkseinstellungen zurückgesetzt."
          }
        },
        "fr" : {
          "stringUnit" : {
