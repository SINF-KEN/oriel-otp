          }
        }
      }
    },
    "The same name or secret in more than one place. If they're the same account, keep the one you use and delete the others." : {
      "comment" : "Account check-up section footer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Derselbe Name oder dasselbe Geheimnis an mehreren Orten. Wenn es dasselbe Konto ist, behalte das, das du verwendest, und lösche die anderen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le même nom ou secret à plusieurs endroits. S’il s’agit du même compte, gardez celui que vous utilisez et supprimez les autres."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "同じ名前またはシークレットが複数の場所にあります。同じアカウントなら、使っているものを残して他を削除してください。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rovnaký názov alebo tajný kľúč na viacerých miestach. Ak ide o ten istý účet, ponechajte ten, ktorý používate, a ostatné vymažte."
          }
        }
      }
    },
    "The server didn't allow deleting this account. Ask the person who runs it to delete it." : {
      "comment" : "Ente account deletion error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
