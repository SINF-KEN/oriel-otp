        }
      }
    },
    "The old and new server are the same." : {
      "comment" : "Ente migration error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der alte und der neue Server sind identisch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’ancien et le nouveau serveur sont identiques."
          }
