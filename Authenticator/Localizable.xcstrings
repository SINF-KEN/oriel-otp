        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odkaz obsahuje rovnaké nastavenie viackrát."
          }
        }
      }
    },
    "The OATH application is disabled or not supported on this YubiKey." : {
      "comment" : "OATH disabled error message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die OATH-Anwendung ist auf diesem YubiKey deaktiviert oder wird nicht unterstützt."
