    },
    "Import from another app…" : {
      "comment" : "Backup settings button that imports accounts exported by another authenticator app",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus anderer App importieren …"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importer depuis une autre app…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのアプリから読み込む…"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importovať z inej aplikácie…"
          }
        }
      }
    },
    "Import reads exports from Google Authenticator (a screenshot of its QR code), Aegis, 2FAS and Raivo without encryption, and text files of otpauth links. The accounts are saved on this device. Delete the export afterwards: anyone with it has the accounts." : {
      "comment" : "Backup settings footer about importing from another authenticator app",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importieren liest Exporte aus Google Authenticator (ein Bildschirmfoto seines QR-Codes), Aegis, 2FAS und Raivo ohne Verschlüsselung sowie Textdateien mit otpauth-Links. Die Konten werden auf diesem Gerät gespeichert. Lösche den Export danach: Wer ihn hat, hat die Konten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’import lit les exports de Google Authenticator (une capture d’écran de son code QR), d’Aegis, de 2FAS et de Raivo sans chiffrement, ainsi que les fichiers texte de liens otpauth. Les comptes sont enregistrés sur cet appareil. Supprimez ensuite l’export : quiconque l’a dispose des comptes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込みでは、Google Authenticator（QRコードのスクリーンショット）、暗号化していないAegis、2FAS、Raivoのエクスポート、otpauthリンクのテキストファイルを読み込めます。アカウントはこのデバイスに保存されます。エクスポートは後で削除してください。持っている人は誰でもアカウントを使えます。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import číta exporty z Google Authenticator (snímka obrazovky jeho QR kódu), Aegis, 2FAS a Raivo bez šifrovania a textové súbory s odkazmi otpauth. Účty sa uložia do tohto zariadenia. Export potom vymažte: ktokoľvek ho má, má aj účty."
          }
        }
      }
    },
    "Accounts imported: %lld" : {
      "comment" : "Import result. The placeholder is a number.",
