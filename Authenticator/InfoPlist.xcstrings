    "NFCReaderUsageDescription" : {
      "comment" : "Privacy - NFC Scan Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halte Deinen YubiKey an Dein Gerät, um per NFC Codes abzurufen und Konten hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold your YubiKey to your device to get codes and add accounts over NFC."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Approchez votre YubiKey de votre appareil pour obtenir des codes et ajouter des comptes via NFC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "YubiKeyをデバイスにかざすと、NFCでコードを取得したりアカウントを追加したりできます。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Priložte YubiKey k zariadeniu a cez NFC získate kódy a pridáte účty."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scanne QR-Codes, um Deinem YubiKey Konten hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scan QR codes to add accounts to your YubiKey."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scannez des codes QR pour ajouter des comptes à votre YubiKey."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "QRコードをスキャンして、YubiKeyにアカウントを追加します。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skenujte QR kódy a pridávajte účty do svojho YubiKey."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mit Face ID entsperrst Du die App, wenn Du sie sperrst, sowie die auf diesem Gerät gespeicherten YubiKey-Passwörter und Deine optionale Ente-Auth-Sitzung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use Face ID to unlock the app if you lock it, the YubiKey passwords and the optional Ente Auth session saved on this device."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilisez Face ID pour déverrouiller l’app si vous la verrouillez, ainsi que les mots de passe YubiKey et votre session Ente Auth facultative enregistrés sur cet appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Face IDを使って、アプリをロックしている場合はアプリを、またこのデバイスに保存したYubiKeyのパスワードと任意のEnte Authセッションをロック解除します。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pomocou Face ID odomknete aplikáciu, ak ju uzamknete, a tiež heslá YubiKey a voliteľnú reláciu Ente Auth uložené v tomto zariadení."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
