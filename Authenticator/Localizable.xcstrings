      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Konto ist nicht auf dem angeschlossenen YubiKey."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte n’est pas sur la YubiKey branchée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続されているYubiKeyにこのアカウントはありません。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účet nie je na pripojenom YubiKey."
          }
        }
      }
    },
    "The code has expired. Request a new one." : {
      "comment" : "Ente sign in error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Code ist abgelaufen. Fordere einen neuen an."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le code a expiré. Demandez-en un nouveau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "コードの有効期限が切れました。新しいコードをリクエストしてください。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Platnosť kódu vypršala. Vyžiadajte si nový."
          }
        }
      }
    },
    "The key doesn't respond" : {
      "comment" : "Timeout issue",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Key antwortet nicht"
          }
        },
        "fr" : {
          "stringUnit" : {
