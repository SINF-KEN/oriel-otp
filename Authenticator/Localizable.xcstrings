                  "value" : "Copié. Un nouveau code arrive dans %lld seconde."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Copié. Un nouveau code arrive dans %lld secondes."
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
