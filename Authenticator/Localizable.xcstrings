        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラウザでパスキーを確認"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overiť prístupový kľúč v prehliadači"
          }
        }
      }
    },
    "Verify your passkey on Ente's website, then come back here." : {
      "comment" : "Ente passkey footer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätige deinen Passkey auf der Website von Ente und komm dann hierher zurück."
