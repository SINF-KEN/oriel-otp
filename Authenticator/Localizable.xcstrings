    "FIDO management over USB-C is not supported by iOS. Use NFC instead, or manage FIDO on a computer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die FIDO-Verwaltung über USB-C wird von iOS nicht unterstützt. Verwende stattdessen NFC oder verwalte FIDO an einem Computer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La gestion FIDO via USB-C n'est pas prise en charge par iOS. Utilisez plutôt la NFC, ou gérez FIDO sur un ordinateur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C経由のFIDO管理はiOSではサポートされていません。代わりにNFCを使用するか、コンピュータでFIDOを管理してください。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systém iOS nepodporuje spravovanie FIDO cez USB-C. Namiesto toho použite NFC alebo spravujte FIDO v počítači."
          }
        }
      }
    },
