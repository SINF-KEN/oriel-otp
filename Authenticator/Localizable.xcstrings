    },
    "The smart card extension requires notifications to be enabled for Oriel OTP. Enable it in the iOS Settings." : {
      "comment" : "PIV extensions notifications alert message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
