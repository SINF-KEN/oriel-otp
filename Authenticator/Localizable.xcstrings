    "Backup saved. Keep the file and its password somewhere safe, away from this device." : {
      "comment" : "Message after a backup was saved",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backup gesichert. Bewahre die Datei und ihr Passwort an einem sicheren Ort auf, nicht auf diesem Gerät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegarde enregistrée. Conservez le fichier et son mot de passe en lieu sûr, à l’écart de cet appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップを保存しました。ファイルとそのパスワードは、このデバイス以外の安全な場所に保管してください。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Záloha bola uložená. Súbor a jeho heslo si uložte na bezpečné miesto mimo tohto zariadenia."
          }
        }
      }
    },
    "Choose a password of at least %lld characters. Anyone with the file can try passwords as often as they like, so pick a long one. You need it to restore the backup: it can't be reset, and it isn't stored in the app." : {
      "comment" : "Backup password footer. The placeholder is the minimum length, 8.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein Passwort mit mindestens %lld Zeichen. Wer die Datei hat, kann beliebig oft Passwörter ausprobieren, wähle also ein langes. Du brauchst es, um das Backup wiederherzustellen: Es kann nicht zurückgesetzt werden und wird nicht in der App gespeichert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un mot de passe d’au moins %lld caractères. Quiconque possède le fichier peut essayer des mots de passe autant de fois qu’il le souhaite, choisissez-en donc un long. Vous en avez besoin pour restaurer la sauvegarde : il ne peut pas être réinitialisé et n’est pas stocké dans l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld文字以上のパスワードを設定してください。ファイルを手に入れた人はパスワードを何度でも試せるため、長いものにしてください。バックアップの復元にはこのパスワードが必要です。リセットはできず、アプリにも保存されません。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvoľte heslo s aspoň %lld znakmi. Každý, kto má súbor, môže skúšať heslá ľubovoľne často, preto zvoľte dlhé. Potrebujete ho na obnovenie zálohy: nedá sa obnoviť a neukladá sa v aplikácii."
          }
        }
      }
    },
    "Copied. A new code comes in %lld seconds." : {
      "comment" : "Toast after copying a code that is about to change. The placeholder is a number of seconds, 5 or less.",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Kopiert. In %lld Sekunde kommt ein neuer Code."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Kopiert. In %lld Sekunden kommt ein neuer Code."
                }
