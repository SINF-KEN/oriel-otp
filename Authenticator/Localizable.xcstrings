          }
        }
      }
    },
    "This removes the account from the YubiKey. You won’t be able to generate codes for it anymore." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird das Konto vom YubiKey entfernt. Du kannst dann keine Codes mehr dafür erzeugen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte sera supprimé de la YubiKey. Vous ne pourrez plus générer de codes pour ce compte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアカウントはYubiKeyから削除されます。以後、このアカウントのコードは生成できなくなります。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Týmto sa účet odstráni z YubiKey. Kódy preň už nebudete môcť generovať."
          }
        }
      }
    },
    "This removes the accounts from the YubiKey. You won’t be able to generate codes for them anymore." : {
      "comment" : "Delete several accounts alert",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden die Konten vom YubiKey entfernt. Sie können danach keine Codes mehr für sie erzeugen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime les comptes de la YubiKey. Vous ne pourrez plus générer de codes pour eux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YubiKeyからアカウントが削除されます。以後、これらのコードは生成できなくなります。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účty sa odstránia z YubiKey. Už pre ne nebudete môcť generovať kódy."
          }
        }
      }
    },
    "This setting is not supported on your YubiKey." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einstellung wird von Deinem YubiKey nicht unterstützt."
          }
        },
        "fr" : {
