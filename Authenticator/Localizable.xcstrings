        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tento účet sa nepodarilo dešifrovať."
          }
        }
      }
    },
    "This account could not be read." : {
      "comment" : "Ente import unreadable account",
      "localizations" : {
        "de" : {
