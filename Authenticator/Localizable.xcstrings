              },
              "many" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "Vybraných je priveľa účtov. Zrušte výber %lld účtu, aby sa všetky zmestili na YubiKey."
                }
              },
              "one" : {
                "stringUnit" : {
