          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Starý a nový server sú rovnaké."
          }
        }
      }
    },
    "The old server ended this session. Open Sync from Ente Auth and enter your password, then try again." : {
      "comment" : "Ente migration error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der alte Server hat diese Sitzung beendet. Öffne „Aus Ente Auth synchronisieren“, gib dein Passwort ein und versuche es erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’ancien serveur a mis fin à cette session. Ouvrez Synchroniser depuis Ente Auth, saisissez votre mot de passe, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "移行元のサーバがこのセッションを終了しました。「Ente Auth から同期」を開いてパスワードを入力してから、もう一度お試しください。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Starý server ukončil túto reláciu. Otvorte Synchronizovať z Ente Auth, zadajte heslo a skúste to znova."
          }
        }
      }
    },
    "The password is wrong, or the file is damaged." : {
      "comment" : "Backup restore error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
