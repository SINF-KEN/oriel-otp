            "state" : "translated",
            "value" : "QR kód"
          }
        }
      }
    },
    "QR code of the account" : {
      "comment" : "VoiceOver label of an account's QR code",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR-Code des Kontos"
          }
        },
        "fr" : {
