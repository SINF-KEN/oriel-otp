    },
    "Too many accounts selected. Deselect %lld so they all fit on the YubiKey." : {
      "comment" : "Ente sync selection too large warning. The placeholder is how many accounts to deselect.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
