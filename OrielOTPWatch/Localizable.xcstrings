    "Turn on Show accounts on Apple Watch in Oriel OTP on your iPhone, under Configuration." : {
      "comment" : "Watch empty state. 'Show accounts on Apple Watch' is the name of the switch, and 'Configuration' the name of the screen it's on, on the iPhone.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aktiviere „Konten auf der Apple Watch zeigen“ in Oriel OTP auf deinem iPhone, unter „Konfiguration“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Activez « Afficher les comptes sur l’Apple Watch » dans Oriel OTP sur votre iPhone, sous « Configuration »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iPhone の Oriel OTP で「設定」を開き、「Apple Watch にアカウントを表示」をオンにしてください。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zapnite „Zobraziť účty na Apple Watch“ v Oriel OTP na iPhone, v časti „Nastavenie“."
          }
        }
      }
    },
