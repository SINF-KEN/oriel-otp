    "File the account under tags" : {
      "comment" : "Toolbar help",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Konto mit Tags versehen"
          }
        },
        "fr" : {
          "stringUnit" : {
