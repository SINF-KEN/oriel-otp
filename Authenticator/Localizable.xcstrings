          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le code de la YubiKey pour ce compte n’est pas le même que celui de sa copie dans Ente Auth ou sur cet appareil, donc rien n’a été modifié."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
