            "value" : "Tento súbor nie je záloha z Oriel OTP ani šifrovaný export z Ente Auth."
          }
        }
      }
    },
    "This server already has an account with this email. Sign in instead." : {
      "comment" : "Ente account creation error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Auf diesem Server gibt es bereits ein Konto mit dieser E-Mail-Adresse. Melde dich stattdessen an."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
