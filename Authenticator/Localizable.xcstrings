        }
      }
    },
    "This account asks for Face ID, Touch ID or the passcode. Copy its code in Oriel OTP." : {
      "comment" : "Shortcuts error when checking the device owner for a protected account failed",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieses Konto fragt nach Face ID, Touch ID oder dem Code. Kopiere seinen Code in Oriel OTP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
