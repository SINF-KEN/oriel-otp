    "%@ (slot %@)" : {
      "comment" : "PIV extension certificate on the YubiKey. The placeholders are the certificate's name and its PIV slot in hexadecimal, e.g. 9A.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (slot %2$@)"
          }
        },
        "de" : {
