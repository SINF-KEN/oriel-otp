    "%@ accounts can't be decrypted and won't be copied. They stay on the old server." : {
      "comment" : "Ente migration review warning. The placeholder is the number of accounts.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Konten können nicht entschlüsselt werden und werden nicht kopiert. Sie bleiben auf dem alten Server."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ comptes ne peuvent pas être déchiffrés et ne seront pas copiés. Ils restent sur l’ancien serveur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@件のアカウントは復号できないためコピーされません。移行元のサーバに残ります。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Účty, ktoré nemožno dešifrovať a neskopírujú sa: %@. Zostanú na starom serveri."
          }
        }
      }
    },
    "%@ · %@" : {
      "comment" : "An account's issuer and name on one line, in the account list with larger text",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      },
      "shouldTranslate" : false
    },
    "A secret on a YubiKey can't be copied off it. These accounts are in Ente Auth or on this device, and a YubiKey can hold them." : {
      "comment" : "Account check-up section footer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Geheimnis auf einem YubiKey kann nicht von ihm kopiert werden. Diese Konten sind in Ente Auth oder auf diesem Gerät, und ein YubiKey kann sie speichern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un secret sur une YubiKey ne peut pas en être copié. Ces comptes sont dans Ente Auth ou sur cet appareil, et une YubiKey peut les contenir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "YubiKey上のシークレットは外部にコピーできません。これらのアカウントはEnte Authまたはこのデバイスにあり、YubiKeyに保存できます。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tajný kľúč na YubiKey sa z neho nedá skopírovať. Tieto účty sú v Ente Auth alebo v tomto zariadení a YubiKey ich dokáže uchovať."
          }
        }
      }
    },
    "Account Check-Up" : {
