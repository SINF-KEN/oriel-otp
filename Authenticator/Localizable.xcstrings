    },
    "AutoFill suggests this account's code on these websites and their subdomains. Without a website, choose the code from the list of codes instead." : {
      "comment" : "AutoFill websites footer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das automatische Ausfüllen schlägt den Code dieses Kontos auf diesen Websites und ihren Subdomains vor. Ohne Website wähle den Code stattdessen in der Liste der Codes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le remplissage automatique propose le code de ce compte sur ces sites web et leurs sous-domaines. Sans site web, choisissez plutôt le code dans la liste des codes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動入力は、これらのWebサイトとそのサブドメインでこのアカウントのコードを提案します。Webサイトがない場合は、コードの一覧からコードを選んでください。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatické vypĺňanie navrhne kód tohto účtu na týchto webových stránkach a ich subdoménach. Bez webovej stránky vyberte kód zo zoznamu kódov."
