      }
    },
    "This file isn't a backup made by Oriel OTP or an encrypted export from Ente Auth." : {
      "comment" : "Backup restore error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei ist weder ein Backup von Oriel OTP noch ein verschlüsselter Export aus Ente Auth."
