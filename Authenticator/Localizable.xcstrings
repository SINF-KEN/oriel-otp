          }
        }
      }
    },
    "This file isn't an export this app can read. Export from Google Authenticator, Aegis, 2FAS or Raivo, or choose a text file of otpauth links." : {
      "comment" : "Import error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei ist kein Export, den die App lesen kann. Exportiere aus Google Authenticator, Aegis, 2FAS oder Raivo, oder wähle eine Textdatei mit otpauth-Links."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier n’est pas un export que l’app sait lire. Exportez depuis Google Authenticator, Aegis, 2FAS ou Raivo, ou choisissez un fichier texte de liens otpauth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルは、このアプリで読み込めるエクスポートではありません。Google Authenticator、Aegis、2FAS、Raivoからエクスポートするか、otpauthリンクのテキストファイルを選択してください。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento súbor nie je export, ktorý aplikácia vie prečítať. Exportujte z Google Authenticator, Aegis, 2FAS alebo Raivo, alebo vyberte textový súbor s odkazmi otpauth."
          }
        }
      }
    },
    "This %@ export is encrypted. Export it again without encryption, import it, then delete the file." : {
      "comment" : "Import error. The placeholder is the name of another authenticator app, e.g. Aegis.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser %@-Export ist verschlüsselt. Exportiere erneut ohne Verschlüsselung, importiere ihn und lösche dann die Datei."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet export %@ est chiffré. Exportez-le à nouveau sans chiffrement, importez-le, puis supprimez le fichier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この%@のエクスポートは暗号化されています。暗号化せずにもう一度エクスポートしてから読み込み、その後ファイルを削除してください。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento export z %@ je zašifrovaný. Exportujte ho znova bez šifrovania, importujte ho a potom súbor vymažte."
          }
        }
      }
    },
    "There are no accounts in this file." : {
      "comment" : "Import error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
