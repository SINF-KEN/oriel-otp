    "You can remove saved password in Settings." : {
      "comment" : "Password entry save password message",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst das gespeicherte Passwort in den Einstellungen entfernen."
          }
        },
        "fr" : {
