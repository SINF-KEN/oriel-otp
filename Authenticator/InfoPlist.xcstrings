    "NFCReaderUsageDescription" : {
      "comment" : "Privacy - NFC Scan Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halte Deinen YubiKey an Dein Gerät, um per NFC Codes abzurufen und Konten hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold your YubiKey to your device to get codes and add accounts over NFC."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Approchez votre YubiKey de votre appareil pour obtenir des codes et ajouter des comptes via NFC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "YubiKeyをデバイスにかざすと、NFCでコードを取得したりアカウントを追加したりできます。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Priložte YubiKey k zariadeniu a cez NFC získate kódy a pridáte účty."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scanne QR-Codes, um Deinem YubiKey Konten hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scan QR codes to add accounts to your YubiKey."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scannez des codes QR pour ajouter des comptes à votre YubiKey."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "QRコードをスキャンして、YubiKeyにアカウントを追加します。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skenujte QR kódy a pridávajte účty do svojho YubiKey."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mit Face ID entsperrst Du die auf diesem Gerät gespeicherten YubiKey-Passwörter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use Face ID to unlock the YubiKey passwords saved on this device."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilisez Face ID pour déverrouiller les mots de passe YubiKey enregistrés sur cet appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Face IDを使用して、このデバイスに保存されているYubiKeyのパスワードのロックを解除します。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pomocou Face ID odomknete heslá k YubiKey uložené v tomto zariadení."
