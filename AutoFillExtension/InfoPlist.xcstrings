    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende Face ID, um Oriel OTP zu entsperren, bevor es einen Bestätigungscode einsetzt, wenn Du die App sperrst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Face ID to unlock Oriel OTP before it fills in a verification code, if you lock the app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Face ID pour déverrouiller Oriel OTP avant qu’il ne remplisse un code de vérification, si vous verrouillez l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリをロックしている場合、確認コードを入力する前にFace IDでOriel OTPのロックを解除します。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak aplikáciu uzamknete, pred vyplnením overovacieho kódu odomknite Oriel OTP pomocou Face ID."
          }
        }
      }
    }
  },
  "version" : "1.0"
