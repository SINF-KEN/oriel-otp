    "Stay signed in" : {
      "comment" : "Ente sign in toggle",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angemeldet bleiben"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rester connecté"
          }
        },
