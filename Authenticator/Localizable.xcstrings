    "Clear passwords saved on this device. This will prompt for a password next time a password protected YubiKey is used." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösche die auf diesem Gerät gespeicherten Passwörter. Dadurch wirst du bei der nächsten Verwendung eines passwortgeschützten YubiKeys nach dem dazugehörigen Passwort gefragt."
