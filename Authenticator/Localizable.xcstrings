          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインしたままにする"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostať prihlásený"
          }
        }
      }
    },
    "Staying signed in keeps your session and the key that decrypts your accounts in the keychain, protected by Face ID or Touch ID, so you can sync again without your password, which is never stored." : {
      "comment" : "Ente sign in stay signed in footer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Angemeldet bleiben“ speichert deine Sitzung und den Schlüssel, der deine Konten entschlüsselt, im Schlüsselbund, geschützt durch Face ID oder Touch ID, damit du ohne dein Passwort erneut synchronisieren kannst. Das Passwort selbst wird nie gespeichert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rester connecté conserve votre session et la clé qui déchiffre vos comptes dans le trousseau, protégées par Face ID ou Touch ID, pour synchroniser à nouveau sans votre mot de passe, qui n’est jamais enregistré."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "サインインしたままにすると、セッションとアカウントを復号する鍵がFace IDまたはTouch IDで保護されてキーチェーンに保存され、パスワードなしで再び同期できます。パスワード自体は保存されません。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pri zostaní prihlásený sa vaša relácia a kľúč, ktorý dešifruje vaše účty, uložia do kľúčenky, chránené Face ID alebo Touch ID, takže môžete znova synchronizovať bez hesla. Samotné heslo sa nikdy neukladá."
          }
        }
      }
    },
    "Staying signed in keeps your session and the key that decrypts your accounts in the keychain, protected by Touch ID or your Mac's password, so you can sync again without your password, which is never stored." : {
      "comment" : "Mac Ente sign in stay signed in footer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Angemeldet bleiben“ speichert deine Sitzung und den Schlüssel, der deine Konten entschlüsselt, im Schlüsselbund, geschützt durch Touch ID oder das Passwort deines Mac, damit du ohne dein Passwort erneut synchronisieren kannst. Das Passwort selbst wird nie gespeichert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rester connecté conserve votre session et la clé qui déchiffre vos comptes dans le trousseau, protégées par Touch ID ou le mot de passe de votre Mac, pour synchroniser à nouveau sans votre mot de passe, qui n’est jamais enregistré."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "サインインしたままにすると、セッションとアカウントを復号する鍵がTouch IDまたはMacのパスワードで保護されてキーチェーンに保存され、パスワードなしで再び同期できます。パスワード自体は保存されません。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pri zostaní prihlásený sa vaša relácia a kľúč, ktorý dešifruje vaše účty, uložia do kľúčenky, chránené Touch ID alebo heslom vášho Macu, takže môžete znova synchronizovať bez hesla. Samotné heslo sa nikdy neukladá."
          }
        }
      }
    },
