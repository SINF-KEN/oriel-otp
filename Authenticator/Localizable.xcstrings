        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichez le code QR à l’écran, copiez-le ou déposez-en une image ici. Pour le photographier avec votre iPhone ou iPad, utilisez le menu Fichier. Ou saisissez les informations ci-dessous."
          }
