    },
    "The passwords didn't match. Choose a password." : {
      "comment" : "App lock change prompt",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Passwörter stimmen nicht überein. Wähle ein Passwort."
