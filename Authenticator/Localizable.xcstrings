          }
        }
      }
    },
    "QR code scanned" : {
      "comment" : "VoiceOver announcement after scanning a QR code",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR-Code gescannt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code QR scanné"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QRコードを読み取りました"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR kód naskenovaný"
          }
        }
      }
    },
    "QR codes are available from the services you wish to secure.\n\nSimply scan the QR code when you add an account and get your own security codes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du erhältst QR-Codes direkt bei den Diensten, die du absichern möchtest.\n\nScanne einfach den QR-Code, wenn du ein Konto hinzufügst, und erhalte deine eigenen Sicherheitscodes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les codes QR sont disponibles auprès des services que vous souhaitez sécuriser.\n\nIl vous suffit de scanner le code QR lorsque vous ajoutez un compte pour obtenir vos propres codes de sécurité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QRコードは、保護したいサービスから入手できます。\n\nアカウントを追加するときにQRコードをスキャンするだけで、セキュリティコードを取得できます。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR kódy sú dostupné v službách, ktoré chcete zabezpečiť.\n\nStačí naskenovať QR kód pri pridávaní účtu a získate vlastné bezpečnostné kódy."
          }
        }
      }
    },
    "QR codes are available from the services you wish to secure.\n\nWhen you add an account, Oriel OTP can find the QR code on your screen, read a copied or dropped picture of it, or take one with your iPhone." : {
      "comment" : "Mac tutorial",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR-Codes erhältst du von den Diensten, die du absichern möchtest.\n\nBeim Hinzufügen eines Kontos findet Oriel OTP den QR-Code auf deinem Bildschirm, liest ein kopiertes oder abgelegtes Bild davon oder nimmt eines mit deinem iPhone auf."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les codes QR sont fournis par les services que vous souhaitez sécuriser.\n\nLorsque vous ajoutez un compte, Oriel OTP peut trouver le code QR à l’écran, lire une image copiée ou déposée, ou en prendre une avec votre iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QRコードは保護したいサービスから入手できます。\n\nアカウントを追加するとき、Oriel OTPは画面上のQRコードを見つけたり、コピーまたはドロップした画像を読み取ったり、iPhoneで撮影したりできます。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR kódy získate od služieb, ktoré chcete zabezpečiť.\n\nPri pridávaní účtu dokáže Oriel OTP nájsť QR kód na obrazovke, prečítať jeho skopírovaný alebo presunutý obrázok alebo ho odfotiť iPhonom."
          }
        }
      }
    },
