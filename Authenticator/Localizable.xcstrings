    "That window couldn't be read. Copy the QR code or drop a picture of it here instead." : {
      "comment" : "Mac QR scan error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieses Fenster konnte nicht gelesen werden. Kopiere stattdessen den QR-Code oder ziehe ein Bild davon hierher."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cette fenêtre n’a pas pu être lue. Copiez plutôt le code QR ou déposez-en une image ici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "そのウインドウを読み取れませんでした。代わりにQRコードをコピーするか、その画像をここにドロップしてください。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toto okno sa nepodarilo prečítať. Namiesto toho skopírujte QR kód alebo sem presuňte jeho obrázok."
          }
        }
      }
    },
    "The account and every Ente Auth account in it are deleted from the server for good. This can't be undone." : {
      "comment" : "Ente account deletion confirmation message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Konto und alle Ente Auth-Konten darin werden endgültig vom Server gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le compte et tous ses comptes Ente Auth sont définitivement supprimés du serveur. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このアカウントと、その中のすべてのEnte Authアカウントがサーバから完全に削除されます。この操作は取り消せません。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Účet a všetky účty Ente Auth v ňom sa natrvalo odstránia zo servera. Túto akciu nie je možné vrátiť späť."
          }
        }
      }
    },
    "The account and its data were deleted from your server. Codes on your YubiKey aren't affected." : {
      "comment" : "Ente account deletion finished footer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Konto und seine Daten wurden von deinem Server gelöscht. Codes auf deinem YubiKey sind davon nicht betroffen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le compte et ses données ont été supprimés de votre serveur. Les codes de votre YubiKey ne sont pas concernés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "アカウントとそのデータがサーバから削除されました。YubiKey上のコードには影響しません。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Účet a jeho údaje boli odstránené z vášho servera. Kódy na vašom YubiKey nie sú ovplyvnené."
          }
        }
      }
    },
    "The account is kept only on this device and isn't in its backups. Back it up in the app's settings or keep the service's recovery codes, as you'd otherwise lose the account with the device." : {
      "comment" : "Add account footer when adding to this device",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Konto wird nur auf diesem Gerät gespeichert und ist nicht in dessen Backups enthalten. Sichere es in den Einstellungen der App oder bewahre die Wiederherstellungscodes des Dienstes auf, denn sonst würdest du mit dem Gerät auch das Konto verlieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte est conservé uniquement sur cet appareil et n’est pas inclus dans ses sauvegardes. Sauvegardez-le dans les réglages de l’app ou gardez les codes de récupération du service, sinon vous perdriez le compte avec l’appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントはこのデバイスにのみ保存され、デバイスのバックアップには含まれません。デバイスを失うとアカウントも失われるため、アプリの設定でバックアップするか、サービスのリカバリーコードを保管してください。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účet sa uchováva iba v tomto zariadení a nie je súčasťou jeho záloh. Zálohujte ho v nastaveniach aplikácie alebo si uschovajte obnovovacie kódy služby, inak by ste so zariadením stratili aj účet."
          }
        }
      }
    },
    "The account isn't in Oriel OTP any more." : {
      "comment" : "Shortcuts error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Konto ist nicht mehr in Oriel OTP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le compte n’est plus dans Oriel OTP."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このアカウントはOriel OTPにもうありません。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Účet už nie je v Oriel OTP."
          }
        }
      }
    },
    "The account on the new server, which may have another email and password. Your password never leaves this device." : {
      "comment" : "Ente migration new server sign in footer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Konto auf dem neuen Server, das eine andere E-Mail-Adresse und ein anderes Passwort haben kann. Dein Passwort verlässt dieses Gerät nie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le compte sur le nouveau serveur, qui peut avoir une autre adresse e-mail et un autre mot de passe. Votre mot de passe ne quitte jamais cet appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "移行先のサーバのアカウントです。メールアドレスとパスワードは異なっていてもかまいません。パスワードがこのデバイスの外に送信されることはありません。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Účet na novom serveri, ktorý môže mať iný e-mail a heslo. Vaše heslo toto zariadenie nikdy neopustí."
          }
        }
      }
    },
    "The accounts on this device can't be read right now. Unlock the device and try again." : {
      "comment" : "Error when changing an account on this device",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Konten auf diesem Gerät können gerade nicht gelesen werden. Entsperre das Gerät und versuche es erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les comptes sur cet appareil ne peuvent pas être lus pour le moment. Déverrouillez l’appareil et réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在、このデバイス上のアカウントを読み取れません。デバイスのロックを解除して、もう一度お試しください。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účty v tomto zariadení sa momentálne nedajú prečítať. Odomknite zariadenie a skúste to znova."
          }
        }
      }
    },
    "The address of the Ente server you host, the one its apps use, like https://auth.example.com. Your email and sign-in requests only go to that server." : {
      "comment" : "Ente sign in footer for a self-hosted server",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Adresse des Ente-Servers, den du betreibst, dieselbe, die seine Apps verwenden, z. B. https://auth.example.com. Deine E-Mail-Adresse und Anmeldeanfragen gehen nur an diesen Server."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’adresse du serveur Ente que vous hébergez, celle qu’utilisent ses apps, par exemple https://auth.example.com. Votre e-mail et vos demandes de connexion ne sont envoyés qu’à ce serveur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "自分でホストしているEnteサーバのアドレスで、そのアプリが使うものです（例：https://auth.example.com）。メールアドレスとサインインのリクエストはそのサーバにのみ送信されます。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Adresa servera Ente, ktorý prevádzkujete, tá istá, ktorú používajú jeho aplikácie, napríklad https://auth.example.com. Váš e-mail a žiadosti o prihlásenie idú len na tento server."
          }
        }
      }
    },
    "The codes didn't match. Choose a code." : {
      "comment" : "App lock change prompt",
      "localizations" : {
        "de" : {
          "stringUnit" : {
