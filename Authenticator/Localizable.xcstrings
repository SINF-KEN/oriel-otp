          }
        }
      }
    },
    "The link gives the same setting more than once." : {
      "comment" : "Error for an otpauth link that repeats a parameter, e.g. the secret",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
