        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de comptes sélectionnés. Désélectionnez-en %lld pour qu'ils tiennent tous sur la YubiKey."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したアカウントが多すぎます。すべてを YubiKey に収めるには、%lld 件の選択を解除してください。"
          }
