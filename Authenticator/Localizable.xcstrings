          "stringUnit" : {
            "state" : "translated",
            "value" : "Platnosť kódu vypršala. Vyžiadajte si nový."
          }
        }
      }
    },
    "The key doesn't respond" : {
      "comment" : "Timeout issue",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Key antwortet nicht"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
