      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließen Sie Ihren YubiKey direkt oder über einen USB-Hub oder Adapter an Ihren Mac an.\n\nBerühren Sie den YubiKey, wenn Sie dazu aufgefordert werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Branchez votre YubiKey sur votre Mac, directement ou via un concentrateur ou un adaptateur USB.\n\nTouchez la YubiKey lorsque vous y êtes invité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YubiKeyをMacに直接、またはUSBハブやアダプタ経由で接続します。\n\n指示が表示されたらYubiKeyにタッチします。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
