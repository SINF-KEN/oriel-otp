    "This QR code is an export from Google Authenticator. To import its accounts, take a screenshot of it, then choose Import from another app in Settings." : {
      "comment" : "Scan QR code error for a Google Authenticator export",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser QR-Code ist ein Export aus Google Authenticator. Um seine Konten zu importieren, mache ein Bildschirmfoto davon und wähle dann in den Einstellungen „Aus anderer App importieren“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce code QR est un export de Google Authenticator. Pour importer ses comptes, faites-en une capture d’écran, puis choisissez Importer depuis une autre app dans les réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このQRコードはGoogle Authenticatorのエクスポートです。アカウントを読み込むには、スクリーンショットを撮ってから、設定で「ほかのアプリから読み込む」を選択してください。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento QR kód je export z Google Authenticator. Ak chcete importovať jeho účty, urobte z neho snímku obrazovky a potom v nastaveniach vyberte Importovať z inej aplikácie."
          }
        }
      }
    }
