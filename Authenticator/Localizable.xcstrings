          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'extension de la carte à puce nécessite que les notifications soient activées pour Oriel OTP. Activez-les dans les paramètres iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートカード拡張機能では、Oriel OTPの通知を有効にする必要があります。iOS設定で有効にしてください。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozšírenie čipovej karty vyžaduje, aby boli pre Oriel OTP povolené oznámenia. Povoľte ich v nastaveniach iOS."
          }
        }
      }
    },
    "The YubiKey's code for this account isn't the same as the code of its copy in Ente Auth or on this device, so nothing was changed." : {
      "comment" : "Error when changing a YubiKey account's touch setting",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
